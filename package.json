{
  "name": "dsh-keep-running",
  "version": "0.1.1",
  "type": "module",
  "description": "Watchdog plugin for DeepSeek Harness: on a 429/quota error, auto-resume the task via a recurring system-reminder until it succeeds.",
  "license": "Apache-2.0",
  "exports": "./lib/index.js",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "quota",
    "rate-limit",
    "watchdog",
    "resume",
    "plugin"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-schedule": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-commands": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-schedule": "^0.1.7-rc.2",
    "@deepseek-ai/schemastery": "*",
    "@types/node": "^26.2.0",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imlishiyuan/dsh-keep-running.git"
  },
  "homepage": "https://github.com/imlishiyuan/dsh-keep-running#readme",
  "bugs": {
    "url": "https://github.com/imlishiyuan/dsh-keep-running/issues"
  }
}
